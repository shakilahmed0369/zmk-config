/*
 * Lily58 (hand-wired, SuperMini nRF52840) - ZMK keymap
 *
 * 4 layers:
 *   0  Base    - plain QWERTY, standard Lily58 positions (changes: "=" top-right, Ctrl/Shift swapped)
 *   1  Lower   - F-keys, symbols, brackets, operators   (hold LEFT thumb  "Lower")
 *   2  Raise   - arrows, Home/End/PgUp/PgDn, edit shortcuts, media (hold RIGHT thumb "Raise")
 *   3  Adjust  - Bluetooth, USB/BLE output, reset, bootloader (hold Lower + Raise)
 *
 * Design rules:
 *   - Base is what every Lily58 ships with, so nothing to relearn for letters/numbers.
 *   - Arrows are an inverted-T on I J K L, same shape as a traditional keyboard.
 *   - Ctrl / Shift / Alt / GUI stay live on every layer, so Ctrl+Raise+Arrow (word jump),
 *     Ctrl+Shift+Raise+Arrow (word select) and Shift+Raise+Arrow (select) all just work.
 *   - Rarely used or risky stuff (Bluetooth clear, reset, bootloader) is only on Adjust,
 *     which needs both thumbs, so it cannot be hit by accident.
 *   - No combos, no home-row mods, no timing tricks: easy to learn, nothing misfires.
 *
 * Edit shortcuts on Raise use Ctrl (LC). On macOS replace every LC( with LG( in the Raise layer.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>


/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   =   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
// | SHIFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | CTRL  |  Z  |  X  |  C   |  V   |  B   |   [    |  |   ]   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                    |  ALT  | GUI | LOWER | SPACE |  | ENTER | RAISE | BSPC | GUI |
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                             &kp N6  &kp N7  &kp N8    &kp N9   &kp N0   &kp EQUAL
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                              &kp Y   &kp U   &kp I     &kp O    &kp P    &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D   &kp F   &kp G                              &kp H   &kp J   &kp K     &kp L    &kp SEMI &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C   &kp V   &kp B   &kp LBKT        &kp RBKT   &kp N   &kp M   &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                           &kp LALT &kp LGUI &mo 1 &kp SPACE        &kp ENTER &mo 2 &kp BSPC &kp RGUI
            >;
        };

        lower_layer {
            display-name = "Lower";
// ------------------------------------------------------------------------------------------------------------
// |  F11  |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F12  |
// |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   _   |
// |   ~   |  |  |  [  |  ]   |  {   |  }   |                   |  \   |  -    |  =    |  +   |   :   |   "   |
// |       |     |     |      |      |      |        |  |        |      |       |  <    |  >   |   ?   |       |
//                    |       |     |       |       |  |       |       |      |     |
            bindings = <
&kp F11    &kp F1      &kp F2    &kp F3    &kp F4      &kp F5                       &kp F6     &kp F7    &kp F8    &kp F9     &kp F10   &kp F12
&kp GRAVE  &kp EXCL    &kp AT    &kp HASH  &kp DOLLAR  &kp PRCNT                    &kp CARET  &kp AMPS  &kp ASTRK &kp LPAR   &kp RPAR  &kp UNDER
&kp TILDE  &kp PIPE    &kp LBKT  &kp RBKT  &kp LBRC    &kp RBRC                     &kp BSLH   &kp MINUS &kp EQUAL &kp PLUS   &kp COLON &kp DOUBLE_QUOTES
&trans     &trans      &trans    &trans    &trans      &trans      &trans   &trans  &trans     &trans    &kp LESS_THAN &kp GREATER_THAN &kp QUESTION &trans
                                           &trans &trans &trans &trans   &trans &trans &trans &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
// ------------------------------------------------------------------------------------------------------------
// | PRTSC |     |     |      |      |      |                   | PREV | PLAY  | NEXT  | VOL- | MUTE  | VOL+  |
// | CAPS  |     |     |      |      |      |                   |      | HOME  |  UP   | END  | PGUP  |       |
// |       | ^A  | ^S  |      | ^F   |      |                   |      | LEFT  | DOWN  | RIGHT| PGDN  |  DEL  |
// |       | ^Z  | ^X  | ^C   | ^V   | ^Y   |        |  |        |      |       |       |      |       |       |
//                    |       |     |       |       |  |       |       |      |     |
// ^ = Ctrl (Cmd if you use LG): A select all, S save, F find, Z undo, X cut, C copy, V paste, Y redo
            bindings = <
&kp PSCRN    &trans         &trans         &trans    &trans         &trans                   &kp C_PREV &kp C_PP   &kp C_NEXT  &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP
&kp CAPSLOCK &trans         &trans         &trans    &trans         &trans                   &trans     &kp HOME   &kp UP      &kp END      &kp PG_UP   &trans
&trans       &kp LC(A)  &kp LC(S)  &trans    &kp LC(F)  &trans                   &trans     &kp LEFT   &kp DOWN    &kp RIGHT    &kp PG_DN   &kp DEL
&trans       &kp LC(Z)  &kp LC(X)  &kp LC(C) &kp LC(V) &kp LC(Y) &trans   &trans    &trans     &trans      &trans       &trans      &trans      &trans
                                           &trans &trans &trans &trans   &trans &trans &trans &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
// ------------------------------------------------------------------------------------------------------------
// | RESET | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | USB  |  BLE  |       |      |       | BOOT  |
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |     |     |      |      |      |                   | BTCLR| CLRALL|       |      |       |       |
// |       |     |     |      |      |      |        |  |        |      |       |       |      |       |       |
//                    |       |     |       |       |  |       |       |      |     |
// Hold Lower + Raise to get here. BT1..BT5 sit on the 1..5 keys.
            bindings = <
&sys_reset &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4      &out OUT_USB &out OUT_BLE &trans &trans &trans &bootloader
&trans     &trans       &trans       &trans       &trans       &trans              &trans       &trans       &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans              &bt BT_CLR   &bt BT_CLR_ALL &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans &trans &trans &trans     &trans       &trans &trans &trans &trans
                                                    &trans &trans &trans &trans   &trans &trans &trans &trans
            >;
        };
    };
};
